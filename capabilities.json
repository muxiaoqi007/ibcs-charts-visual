{
  "dataRoles": [
    {
      "displayName": "类目",
      "name": "category",
      "kind": "Grouping"
    },
    {
      "displayName": "实际值",
      "name": "actual",
      "kind": "Measure"
    },
    {
      "displayName": "对比值（上年/计划）",
      "name": "comparison",
      "kind": "Measure"
    },
    {
      "displayName": "工具提示",
      "description": "鼠标悬停在类目上时显示的其他度量值。",
      "name": "Tooltips",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": { "max": 1 },
          "actual": { "max": 1 },
          "comparison": { "max": 1 }
        }
      ],
      "categorical": {
        "categories": {
          "for": { "in": "category" },
          "dataReductionAlgorithm": { "top": { "count": 250 } }
        },
        "values": {
          "select": [
            { "bind": { "to": "actual" } },
            { "bind": { "to": "comparison" } },
            { "for": { "in": "Tooltips" } }
          ]
        }
      }
    }
  ],
  "objects": {
    "chartSettings": {
      "displayName": "图表设置",
      "properties": {
        "layout": {
          "displayName": "布局",
          "type": {
            "enumeration": [
              { "displayName": "响应式", "value": "responsive" },
              { "displayName": "集成差异", "value": "integratedVariance" },
              { "displayName": "绝对差异", "value": "absolute" },
              { "displayName": "相对差异", "value": "relative" },
              { "displayName": "绝对差异 / 相对差异", "value": "absoluteRelative" },
              { "displayName": "实际值 / 绝对差异", "value": "actualAbsolute" },
              { "displayName": "实际值 / 相对差异", "value": "actualRelative" },
              { "displayName": "实际值", "value": "actual" }
            ]
          }
        },
        "invertVarianceColors": {
          "displayName": "反转差异颜色",
          "type": { "bool": true }
        },
        "treatNullsAsZeros": {
          "displayName": "将空值视为零",
          "type": { "bool": true }
        },
        "grandTotal": {
          "displayName": "显示总计",
          "type": { "bool": true }
        },
        "showVerticalAxis": {
          "displayName": "显示纵轴",
          "type": { "bool": true }
        }
      }
    },
    "colors": {
      "displayName": "颜色",
      "properties": {
        "actualColor": {
          "displayName": "实际值",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "comparisonColor": {
          "displayName": "对比值（上年/计划）",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "positiveColor": {
          "displayName": "有利差异",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "negativeColor": {
          "displayName": "不利差异",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "baselineColor": {
          "displayName": "基准线",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "scenarioLabels": {
      "displayName": "场景标签",
      "properties": {
        "actualLabel": {
          "displayName": "实际值缩写",
          "type": { "text": true }
        },
        "comparisonLabel": {
          "displayName": "对比值缩写",
          "type": { "text": true }
        }
      }
    },
    "columnDesign": {
      "displayName": "柱形设计",
      "properties": {
        "overlapActualPercent": {
          "displayName": "重叠实际柱宽度 (%)",
          "type": { "numeric": true }
        },
        "overlapComparisonPercent": {
          "displayName": "重叠对比柱宽度 (%)",
          "type": { "numeric": true }
        },
        "integratedActualPercent": {
          "displayName": "集成实际柱宽度 (%)",
          "type": { "numeric": true }
        },
        "integratedVariancePercent": {
          "displayName": "集成差异块宽度 (%)",
          "type": { "numeric": true }
        },
        "variancePanelPercent": {
          "displayName": "独立差异柱宽度 (%)",
          "type": { "numeric": true }
        }
      }
    },
    "topN": {
      "displayName": "前 N 项与其他",
      "properties": {
        "mode": {
          "displayName": "筛选方式",
          "type": {
            "enumeration": [
              { "displayName": "关闭", "value": "off" },
              { "displayName": "前 N 项", "value": "top" },
              { "displayName": "后 N 项", "value": "bottom" },
              { "displayName": "前后 N 项", "value": "topBottom" }
            ]
          }
        },
        "count": {
          "displayName": "保留项数",
          "type": { "integer": true }
        },
        "rankBy": {
          "displayName": "排序依据",
          "type": {
            "enumeration": [
              { "displayName": "实际值", "value": "actual" },
              { "displayName": "绝对差异", "value": "absoluteVariance" }
            ]
          }
        },
        "includeOthers": {
          "displayName": "汇总为“其他”",
          "type": { "bool": true }
        }
      }
    },
    "dataLabels": {
      "displayName": "数据标签",
      "properties": {
        "show": {
          "displayName": "显示数据标签",
          "type": { "bool": true }
        },
        "fontSize": {
          "displayName": "数值字号",
          "type": { "formatting": { "fontSize": true } }
        },
        "categoryFontSize": {
          "displayName": "类目字号",
          "type": { "formatting": { "fontSize": true } }
        },
        "decimalPlaces": {
          "displayName": "小数位数",
          "type": { "integer": true }
        },
        "displayUnits": {
          "displayName": "显示单位",
          "type": {
            "enumeration": [
              { "displayName": "自动", "value": "auto" },
              { "displayName": "无", "value": "none" },
              { "displayName": "千 (K)", "value": "thousands" },
              { "displayName": "百万 (M)", "value": "millions" },
              { "displayName": "十亿 (B)", "value": "billions" },
              { "displayName": "万亿 (T)", "value": "trillions" }
            ]
          }
        }
      }
    },
    "title": {
      "displayName": "标题",
      "properties": {
        "show": {
          "displayName": "显示标题",
          "type": { "bool": true }
        },
        "text": {
          "displayName": "标题文本",
          "type": { "text": true }
        },
        "fontSize": {
          "displayName": "标题字号",
          "type": { "formatting": { "fontSize": true } }
        }
      }
    }
  },
  "sorting": { "default": {} },
  "tooltips": {
    "supportedTypes": { "default": true, "canvas": true },
    "roles": ["Tooltips"],
    "supportEnhancedTooltips": true
  },
  "suppressDefaultTitle": true,
  "supportsKeyboardFocus": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "supportsHighlight": true,
  "privileges": []
}
